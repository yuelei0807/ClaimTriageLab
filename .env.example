# Real inference: choose groq or gemini. Do not commit actual secrets.
CLAIMTRIAGE_LLM_PROVIDER=groq
CLAIMTRIAGE_LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GEMINI_API_KEY=

# Qdrant Cloud free cluster for semantic evidence retrieval.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=claim-evidence

# Langfuse Cloud free project or a self-hosted endpoint.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# A public host needs durable relational storage; local SQLite is not durable on Render free.
DATABASE_URL=

# Hosted reviewer runtime. Generate long random values; never commit them.
CLAIMTRIAGE_REVIEWER_ID=showcase_reviewer
CLAIMTRIAGE_REVIEWER_PASSWORD=
CLAIMTRIAGE_CSRF_SECRET=
CLAIMTRIAGE_WEBHOOK_API_KEY=
CLAIMTRIAGE_DATABASE_PATH=/tmp/claimtriage/showcase.sqlite3
